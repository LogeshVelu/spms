# ============================================================================
# SPMS - Database & Environment Configuration
# ============================================================================

# Server Port
PORT=5050

# JWT Authentication Secret
JWT_SECRET=spms_master_production_secret_key_2026_iitm_secure

# Database Engine Selection ('postgres' or 'sqlite')
DB_TYPE=postgres

# PostgreSQL Connection Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spms

# Alternative Individual PostgreSQL Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=spms
